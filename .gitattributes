# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows-specific scripts must use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Linux/macOS scripts must use LF
*.sh text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.ico binary
*.svg binary
*.woff2 binary
