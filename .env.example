# Quant Trading Application — Environment Variables
# Copy this file to .env and adjust values for your setup.

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string
# Linux:   postgresql://<user>:<password>@localhost:5432/quant
# Windows: postgresql://<user>:<password>@localhost:5432/quant
DATABASE_URL=postgresql://petrick:market_dev@localhost:5432/quant

# ── Data Sources ──────────────────────────────────────────────────
YF_TIMEOUT=30
IDX_BASE_URL=https://www.idx.co.id

# ── GPU / CUDA ────────────────────────────────────────────────────
# Preferred GPU for compute. GPU 0 = display, GPU 1 = compute.
# Set to "cpu" to force CPU-only mode.
CUDA_DEVICE=cuda:1

# ── Timezone ──────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ── Trading Parameters ────────────────────────────────────────────
INITIAL_CAPITAL=100000000
COMMISSION_RATE=0.0015
SALES_TAX_RATE=0.001
SLIPPAGE_RATE=0.001

# ── Logging ───────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── LLM (Phase 3 — Multi-Agent AI) ────────────────────────────────
# Provider: ollama (local), openai (API), unknown (disabled)
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-r1:1.5b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
